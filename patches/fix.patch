From def4417f34fda80975b5834ad84bb098959e9465 Mon Sep 17 00:00:00 2001
From: byeonghopark <p4569zz@gmail.com>
Date: Thu, 22 Oct 2026 14:57:32 +0900
Subject: [PATCH] fix(android): handle onRenderProcessGone in the dispose()
 WebViewClient

dispose() swaps in an anonymous WebViewClient and defers destroy() to
onPageFinished of about:blank. Until that load finishes the WebView is still
alive and attached to the renderer, so when the renderer goes away Chromium
asks it via onRenderProcessGone. The anonymous client did not override it and
returned the default false, which makes the WebView terminate the whole app
("Render process's crash wasn't handled by all associated webviews" / SIGKILL
for OOM kills), regardless of the app's own onRenderProcessGone handling.

Destroy the WebView right away and report the crash as handled.
---
 .../webview/in_app_webview/InAppWebView.java         | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/flutter_inappwebview_android/android/src/main/java/com/pichillilorenzo/flutter_inappwebview_android/webview/in_app_webview/InAppWebView.java b/flutter_inappwebview_android/android/src/main/java/com/pichillilorenzo/flutter_inappwebview_android/webview/in_app_webview/InAppWebView.java
index 7cf3f7f5..47ee300b 100755
--- a/flutter_inappwebview_android/android/src/main/java/com/pichillilorenzo/flutter_inappwebview_android/webview/in_app_webview/InAppWebView.java
+++ b/flutter_inappwebview_android/android/src/main/java/com/pichillilorenzo/flutter_inappwebview_android/webview/in_app_webview/InAppWebView.java
@@ -46,6 +46,7 @@ import android.view.inputmethod.InputConnection;
 import android.view.inputmethod.InputMethodManager;
 import android.webkit.CookieManager;
 import android.webkit.DownloadListener;
+import android.webkit.RenderProcessGoneDetail;
 import android.webkit.URLUtil;
 import android.webkit.ValueCallback;
 import android.webkit.WebBackForwardList;
@@ -2191,6 +2192,17 @@ final public class InAppWebView extends InputAwareWebView implements InAppWebVie
       public void onPageFinished(WebView view, String url) {
         destroy();
       }
+
+      @RequiresApi(api = Build.VERSION_CODES.O)
+      @Override
+      public boolean onRenderProcessGone(WebView view, RenderProcessGoneDetail detail) {
+        // The renderer went away before about:blank finished loading, so onPageFinished
+        // (and therefore destroy()) may never run. This WebView is still alive, so Chromium
+        // asks it whether it handled the crash: returning false (the default) makes the
+        // WebView kill the whole app. It is being disposed anyway, so destroy it now.
+        destroy();
+        return true;
+      }
     });
     interceptOnlyAsyncAjaxRequestsPluginScript = null;
     userContentController.dispose();
-- 
